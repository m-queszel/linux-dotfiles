# shellcheck shell=bash
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias grep='grep --color=auto'
if [[ -r ${XDG_CONFIG_HOME:-$HOME/.config}/ls-colors ]]; then
    LS_COLORS=$(<"${XDG_CONFIG_HOME:-$HOME/.config}/ls-colors")
    export LS_COLORS
fi
PS1='[\u@\h \W]\$ '

command -v starship >/dev/null && eval "$(starship init bash)"
