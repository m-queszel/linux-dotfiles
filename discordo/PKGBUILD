pkgname=discordo
_commit=8c87531e7518eae4688f603afb79c5b147f79946
pkgver=r1706.8c87531
pkgrel=1
pkgdesc='Terminal Discord client, pinned to a reviewed commit'
arch=('x86_64')
url='https://github.com/ayn2op/discordo'
license=('GPL-3.0-or-later')
depends=('glibc')
makedepends=('go' 'git')
optdepends=('wl-clipboard: clipboard support on Wayland'
            'libpulse: voice channel audio')
source=("$pkgname::git+$url.git#commit=$_commit")
sha256sums=('SKIP')

build() {
    cd "$pkgname"
    export CGO_CPPFLAGS="$CPPFLAGS"
    export CGO_CFLAGS="$CFLAGS"
    export CGO_CXXFLAGS="$CXXFLAGS"
    export CGO_LDFLAGS="$LDFLAGS"
    export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
    go build -o "$pkgname" .
}

package() {
    cd "$pkgname"
    install -Dm755 "$pkgname" "$pkgdir/usr/bin/$pkgname"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
