/* Generated by matugen from {{ image }}
 * Do not edit: run `wallpaper <image>` instead. Read on every rofi launch. */
* {
    surface: {{ colors.surface_container.default.hex }}e6;
    field: {{ colors.surface_container_highest.default.hex }};
    text: {{ colors.on_surface.default.hex }};
    text-dim: {{ colors.on_surface_variant.default.hex }};
    accent: {{ colors.primary.default.hex }};
    selected: {{ colors.primary_container.default.hex }};
    on-selected: {{ colors.on_primary_container.default.hex }};
    border: {{ colors.outline_variant.default.hex }};
}
