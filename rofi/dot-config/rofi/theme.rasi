/* Fallback colors only; matugen's generated colors.rasi overrides them. */
* {
    surface: #2a201be6;
    raise: #31282e;
    text: #f0dfd7;
    text-dim: #d7c2b8;
    accent: #ffb68a;
    edge: #ffb68a;
    shadow: #cbc992;
    selected: #6b3b1e;
    on-selected: #ffdbc8;
}

?import "colors.rasi"

* {
    font: "0xProto Nerd Font 12";
    background-color: transparent;
    text-color: @text;
}

/* rofi has no box-shadow: the window's right/bottom border is the hard shadow behind mainbox */
window {
    location: center;
    anchor: center;
    width: 645px;
    border: 0px 5px 5px 0px;
    border-color: @shadow;
    border-radius: 10px;
}

mainbox {
    padding: 14px;
    spacing: 12px;
    border: 2px;
    border-color: @edge;
    border-radius: 8px;
    background-color: @surface;
    children: [ inputbar, message, listview ];
}

inputbar {
    padding: 10px 14px;
    spacing: 12px;
    border: 2px;
    border-color: @text-dim;
    border-radius: 6px;
    background-color: @raise;
    children: [ prompt, entry ];
}

prompt {
    font: "0xProto Nerd Font 13";
    text-color: @accent;
    vertical-align: 0.5;
}

entry {
    placeholder: "Search";
    placeholder-color: @text-dim;
    cursor: text;
    vertical-align: 0.5;
}

message {
    padding: 10px 14px;
    border: 2px;
    border-color: @text-dim;
    border-radius: 6px;
    background-color: @raise;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: true;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 7px 12px;
    spacing: 12px;
    border: 2px;
    border-color: transparent;
    border-radius: 6px;
    cursor: pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
}

element selected.normal {
    background-color: @selected;
    border-color: @text;
    text-color: @on-selected;
}

element-icon {
    size: 28px;
    vertical-align: 0.5;
    cursor: inherit;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    cursor: inherit;
}
