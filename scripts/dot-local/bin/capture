#!/usr/bin/env bash
# Screenshots and screen recordings for sharing.
#
#   capture screen    full-screen screenshot
#   capture region    screenshot of an area picked with the mouse
#   capture record    start or stop a screen recording (gpu-screen-recorder)
#
# Screenshots go to ~/Pictures/Screenshots and the clipboard; recordings to ~/Videos.
set -euo pipefail

PICS="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
VIDS="${XDG_VIDEOS_DIR:-$HOME/Videos}"
stamp=$(date +%Y-%m-%d_%H-%M-%S)

shot() {
    mkdir -p "$PICS"
    local file="$PICS/$stamp.png"
    grim "$@" "$file"
    wl-copy --type image/png <"$file"
    notify-send -a capture -i "$file" "Screenshot saved" "$file"
}

record() {
    # -f: the process name is longer than the 15 characters pkill -x can match
    if pkill -INT -f '^gpu-screen-recorder '; then
        notify-send -a capture "Recording saved" "$VIDS"
        return
    fi
    command -v gpu-screen-recorder >/dev/null || {
        notify-send -u critical -a capture "capture" "gpu-screen-recorder isn't installed"
        exit 1
    }
    mkdir -p "$VIDS"
    # Short-lived and before the first frame, so the notification stays out of the clip
    notify-send -a capture -t 1500 "Recording in 2s" "Press the same key again to stop"
    sleep 2
    exec gpu-screen-recorder -w screen -f 60 -a default_output -ac aac -o "$VIDS/$stamp.mp4"
}

case "${1:-}" in
screen) shot ;;
region) shot -g "$(slurp)" ;;
record) record ;;
*)
    sed -n '2,8s/^# \{0,1\}//p' "$0" >&2
    exit 2
    ;;
esac
