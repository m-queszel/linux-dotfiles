#!/usr/bin/env bash
set -euo pipefail

cache=${XDG_CACHE_HOME:-$HOME/.cache}/pixel-prompt
colors=${XDG_STATE_HOME:-$HOME/.local/state}/theme/colors.json
zdir=${XDG_CONFIG_HOME:-$HOME/.config}/zsh

[[ -d $cache ]] || exit 0
exec 9>"$cache/.refresh.lock"
flock 9

for dir in "$cache"/*x*/; do
    dir=${dir%/} cell=${dir##*/}
    python3 -I "$zdir/pixel-cursor.py" "${cell%x*}" "${cell#*x}" "$colors" "$dir" &
    if [[ -e $dir/title.vars ]]; then
        python3 -I "$zdir/armillary.py" "${cell%x*}" "${cell#*x}" "$colors" "$dir" &
    fi
done
wait

for f in "$cache"/shells/*; do
    [[ -e $f ]] || continue
    pid=${f##*/}
    stat=$(cat "/proc/$pid/stat" 2>/dev/null) || stat=
    read -ra fields <<<"${stat##*) }"
    # Field 22 (start time) must match what the shell registered, or the pid now belongs to another process
    if [[ -n $stat && ${fields[19]} == "$(<"$f")" ]]; then
        kill -USR1 "$pid" 2>/dev/null || true
    else
        rm -f "$f"
    fi
done
