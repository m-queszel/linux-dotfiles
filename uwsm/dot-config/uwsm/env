# Session environment for every app, loaded by uwsm at login (re-login to apply).
# Hyprland-only variables (HYPR*, AQ_*) go in env-hyprland.
export XCURSOR_THEME=capitaine-cursors
export XCURSOR_SIZE=24

# Qt apps take their palette, icons and fonts from qt6ct (colors generated by matugen)
export QT_QPA_PLATFORMTHEME=qt6ct

# User scripts (e.g. `wallpaper`) for keybinds and services, not just shells
export PATH="$HOME/.local/bin:$PATH"
